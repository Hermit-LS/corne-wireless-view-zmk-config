#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        spaceshift: spaceshift {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACESHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <38>;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp F     &kp P  &kp B        &kp J      &kp L  &kp U          &kp Y    &kp SEMICOLON  &kp RIGHT_GUI
&kp LCTRL       &hml LEFT_GUI A  &hml LEFT_ALT R  &hml LEFT_SHIFT S  &hml LEFT_CONTROL T  &kp G        &kp M      &hmr RIGHT_CTRL N  &hmr RIGHT_SHIFT E  &hmr RIGHT_ALT I  &hmr RIGHT_GUI O &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C     &kp D  &kp V        &kp K      &kp H  &kp COMMA      &kp DOT  &kp FSLH       &kp ESC
                              &kp DELETE  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp BACKSPACE
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6        &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
&trans  &none   &none   &none   &none   &none     &none         &none   &trans  &trans  &trans   &trans
                        &trans  &trans  &trans    &trans        &trans  &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&trans  &none      &kp TILDE      &kp GRAVE  &kp LEFT_BRACE        &kp RIGHT_BRACE          &none   &none           &none      &none       &none     &kp BACKSPACE
&trans  &kp CARET  &kp BACKSLASH  &kp PIPE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &none   &kp MINUS       &kp EQUAL  &kp EXCL    &kp AT    &none
&trans  &kp HASH   &kp PERCENT    &kp STAR   &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &none   &kp UNDERSCORE  &kp PLUS   &kp DOLLAR  &kp AMPS  &none
                                  &trans     &trans                &trans                   &trans  &trans          &trans
            >;
        };

        Functions {
            display-name = "Functions";
            bindings = <
&bt BT_CLR  &none     &none      &none      &kp INS  &none        &kp C_NEXT        &kp LS(LG(LEFT))  &kp LS(LG(DOWN))  &kp LS(LG(UP_ARROW))  &kp LS(LG(RIGHT))  &kp BACKSPACE
&bt BT_NXT  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &kp SPACE    &kp C_PLAY_PAUSE  &kp LEFT          &kp DOWN          &kp UP                &kp RIGHT          &none
&bt BT_PRV  &none     &none      &none      &none    &none        &kp C_PREVIOUS    &kp BACKSPACE     &none             &none                 &none              &to 4
                                 &kp LGUI   &mo 1    &kp SPACE    &kp ENTER         &mo 2             &kp RIGHT_ALT
            >;
        };

        Gaming1 {
            display-name = "Gaming";
            bindings = <
&kp ESC    &kp EQUAL     &kp Q  &kp W  &kp E      &kp R        &kp T      &kp Y     &kp U     &kp I          &kp O             &kp P
&kp TAB    &kp MINUS     &kp A  &kp S  &kp D      &kp F        &kp G      &kp H     &kp J     &kp K          &kp L             &kp SEMI
&kp LCTRL  &kp LEFT_ALT  &kp Z  &kp X  &kp C      &kp V        &kp B      &kp N     &kp M     &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION
                                &mo 5  &kp LSHFT  &kp SPACE    &kp ENTER  &kp BSPC  &kp LGUI
            >;
        };

        Gaming2 {
            display-name = "Gaming_R";
            bindings = <
&kp F9  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp BACKSPACE
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans        &kp NUMBER_6  &kp N7        &kp N8        &kp N9    &trans  &trans  &trans  &trans  &trans   &to 0
                                    &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Func {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
